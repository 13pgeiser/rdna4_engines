+/* RADIANCE: autoparser::analyze_template renders the template over synthetic messages and reads
+ * nothing but the template, so one analysis serves every request rendered through it. One that
+ * throws is not kept, and the next request analyses again and throws again. */
+static std::shared_ptr<const autoparser::autoparser> template_analysis(
+        const common_chat_templates * tmpls, const common_chat_template & tmpl) {
+    const size_t slot = &tmpl == tmpls->template_default.get() ? 0 : 1;
+    {
+        std::lock_guard<std::mutex> lock(tmpls->analysis_lock);
+        if (tmpls->analysis[slot]) {
+            return tmpls->analysis[slot];
+        }
+    }
+    auto made = std::make_shared<autoparser::autoparser>();
+    made->analyze_template(tmpl);
+    std::lock_guard<std::mutex> lock(tmpls->analysis_lock);
+    if (!tmpls->analysis[slot]) {
+        tmpls->analysis[slot] = std::move(made);
+    }
+    return tmpls->analysis[slot];
+}
