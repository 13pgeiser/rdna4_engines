# gemma4-26b-a4b-df-bf16x.recipe -- gemma-4-26B-A4B-it with z-lab's DFlash drafter and the routed
# experts left bf16, as arch/gemma4 serves it.
#
#   rad-convert <gemma-4-26B-A4B-it checkpoint> --draft-model <gemma-4-26B-A4B-it-DFlash checkpoint> \
#       --recipe data/recipes/gemma4-26b-a4b-df-bf16x.recipe -o gemma4-26b-a4b-df-bf16x.rad
#
# The trunk exactly as the checkpoint holds it -- the bf16 reference the fp8-expert containers are
# measured against (radiance --kld-record) -- with only the drafter quantised.

# The DFlash drafter's six linears: block fp8 (the drafter only proposes; the trunk verifies).
dflash.fc.weight                     rtn codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_q.weight           rtn codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_k.weight           rtn codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_v.weight           rtn codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_output.weight      rtn codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.ffn_gate_up.weight      rtn codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.ffn_down.weight         rtn codes=fp8_e4m3 block=128x128 scale=bf16

# The drafter's head: the target's tied table again under a name of its own, block fp8, which the
# draft head reads instead of the bf16 table -- half the widest read on the draft path, for half
# the table's bytes again (176 MiB a rank at tp 4). Drafts are verified, so this changes what is
# proposed, never what is accepted.
dflash.draft_head.weight             rtn codes=fp8_e4m3 block=128x128 scale=bf16
