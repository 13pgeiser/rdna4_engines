# sage-a1.5-fp8-df2.recipe -- Sage-A1.5 with incoai's Qwen3.6-35B-A3B DFlash2 drafter merged in
# place of the MTP head. The trunk rules are sage-a1.5-fp8.recipe's unchanged; the drafter's
# linears take the same 128x128 block form as the trunk, and its draft head is the target's
# lm_head as the 2-bit copy the draft rounds read.
#
#   rad-convert InternScience/Sage-A1.5-FP8 \
#       --draft-model incoai/Qwen3.6-35B-A3B-DFlash2 \
#       --recipe data/recipes/sage-a1.5-fp8-df2.recipe -o sage-a1.5-fp8-df2.rad
#
# The drafter is a DFlash2DraftModel: six Qwen3-shaped layers at 2048, eight taps
# (target_layer_ids 1 6 11 16 22 27 32 37), block 8, selector rank 256 / top 16, vocab 248320.
# Sage's text_config is Qwen3.6-35B-A3B's key for key, so the drafter's geometry matches the
# trunk it was trained against. qwen35moe_fp8 (qwen35_fp8.cpp with QWEN35_MOE=1) declares it and
# drops the MTP head, which is then neither declared nor carried.
#
# The drafter's norms, the selector's projection and codebooks, and the convolution kernels and
# bases stay bf16/f32 as the checkpoint holds them.

blk.*.attn_qg.weight                 rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_k.weight                  rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_v.weight                  rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_output.weight             rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ssm_inz.weight                 rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ssm_out.weight                 rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ffn_gate_up_exps.*.weight      rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ffn_down_exps.*.weight         rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ffn_gate_up_shexp.weight       rtn  codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ffn_down_shexp.weight          rtn  codes=fp8_e4m3 block=128x128 scale=bf16
output.weight                        rtn  codes=fp8_e4m3 block=128x128 scale=bf16

dflash.fc.weight                     rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_q.weight           rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_k.weight           rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_v.weight           rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.attn_output.weight      rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.ffn_gate_up.weight      rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.blk.*.ffn_down.weight         rtn  codes=fp8_e4m3 block=128x128 scale=bf16
dflash.draft_head.weight             rtn  codes=u2 zero=u8 group=128 scale=f16
