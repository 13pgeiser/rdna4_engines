// The gfx1201 MQ4 down NT4 / NT8 entries of `qwen4_moe_sym` (flat-slot and grouped-position), with
// the K-loop composed in `.rip` from the `qdown::*` natives of `qwen4_moe_sym::down_blocks`.
//
// `qwen4_moe_sym::emit(spec)` (down NT4/NT8) and `emit_down_gp(spec)` are the oracle: for every
// valid entry this script re-emits their bytes (`s_text` and proof). A test in peacemaker-rip
// (`qwen4_moe_down_twin_matches_the_rust_emit`) requires it. Edit the K-loop below and re-run:
// no rebuild.
//
// What is script-level here: the K-loop's trip structure (which loop, when it is skipped), the
// ORDER of weight loads and epoch folds inside a trip (`qdown::load_w`, `qdown::compute`), the
// descriptor step (`qdown::advance`), the trip counter, the odd/even tail and the kernel exit. The
// prologue, one epoch's fold (`compute`: WMMA, the fold, the per-tile liveness branches and the
// next-epoch activation loads), the tail (an odd/even `if_else` over a pair or one fold) and the
// store epilogue are single Rust blocks: each interleaves instruction emission with branches. The down entries have no LDS and
// no ring, so there is no LDS statement to move. Tile geometry (`nt`, 64 rows x nt x 16 tokens per
// wave group, the register map) is a spec axis of the Rust generator and needs a rebuild.
//
// Variant grammar: `down[_gp]_ntN`:
//
//     down_nt4        flat-slot down NT4   (the oracle anchor entry)
//     down_nt8        flat-slot down NT8
//     down_gp_nt4     grouped-position down NT4 (reads the down A4 plane at `g * m_total + row`)
//     down_gp_nt8     grouped-position down NT8
//
// The names are the pm_loop `--epi` names. gfx1201 only.

const ARCHES: &[&str] = &["gfx1201"];

const VARIANTS: &[&str] = &["down_nt4", "down_nt8", "down_gp_nt4", "down_gp_nt8"];

fn emit(spec: Spec) -> Result<Emitted, String> {
    let (nt, gp) = entry(&spec.variant)?;
    let g = QDownGen::new(nt, gp, spec.arch)?;
    let mut b = Builder::new(g.kernel_spec(), g.plan()?);
    b.enable_delay_alu();
    let mut wg = Workgroup::new(&mut b, spec.arch)?;
    author(&mut wg, &g)?;
    b.finish()
}

// The variant name as `(nt, gp)`.
fn entry(variant: &str) -> Result<(u8, bool), String> {
    let parts: Vec<&str> = variant.split('_').collect();
    let gp = parts.len() == 3 && parts[1] == "gp";
    if parts[0] != "down" || !(parts.len() == 2 || gp) {
        return Err(format!("variant `{variant}`: expected down[_gp]_ntN"));
    }
    match parts[parts.len() - 1] {
        "nt4" => Ok((4, gp)),
        "nt8" => Ok((8, gp)),
        t => Err(format!("variant `{variant}`: unknown tile width `{t}` (nt4, nt8)")),
    }
}

// The Workgroup scope lives here, not in emit(): emit() mentions `b` again at finish(), which
// would end the scope under any later `wg` use.
fn author<T: Target>(wg: &mut Wg<T>, g: &QDownGen) -> Result<(), String> {
    let end = wg.exit(g.exit_label())?;
    qdown::prologue(wg, g, end)?;
    kloop(wg, g)?;
    qdown::epilogue(wg, g, end)?;
    wg.end(end)
}

// The K loop. One trip is two epochs (K128 each): weights of epoch 1 are issued before the fold of
// epoch 0, weights of epoch 0 before the fold of epoch 1, and each fold re-issues its tiles'
// activations of the NEXT epoch through the other descriptor (`reload`). K/128 epochs: (K/128 - 1)/2
// full trips, then the tail block: one pair (even K/128) or one epoch (odd K/128).
fn kloop<T: Target>(wg: &mut Wg<T>, g: &QDownGen) -> Result<(), String> {
    wg.label(g.label("k_begin"))?;
    let no_trip = qdown::trips_cmp(wg, "s_cmp_eq_u32")?;
    wg.wg_skip_if(no_trip, g.label("k_loop_end"), (), |wg, st| {
        wg.loop_carried(g.label("k_loop"), (), |wg, st| {
            qdown::load_w(wg, g, 1)?;
            qdown::compute_reload(wg, g, 0, "l0", qdown::srd_x(1)?)?;
            qdown::advance(wg)?;
            qdown::load_w(wg, g, 0)?;
            qdown::compute_reload(wg, g, 1, "l1", qdown::srd_x(0)?)?;
            qdown::trips_dec(wg)?;
            let more = qdown::trips_cmp(wg, "s_cmp_lg_u32")?;
            Ok(more)
        })?;
        Ok(())
    })?;
    // After the trips: one epoch left when K/128 is odd, else two (one block: the branch is wave
    // scope, which a typed block cannot sit under).
    qdown::tail(wg, g)
}
